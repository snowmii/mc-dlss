#
# https://help.github.com/articles/dealing-with-line-endings/
#

# Normalize text files; binary detection via git's own heuristics
* text=auto

# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Source and docs store as LF regardless of checkout platform
*.cpp           text eol=lf
*.h             text eol=lf
*.kt            text eol=lf
*.java          text eol=lf
*.kts           text eol=lf
*.md            text eol=lf
*.json          text eol=lf
*.properties    text eol=lf
*.fsh           text eol=lf
*.comp          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf

