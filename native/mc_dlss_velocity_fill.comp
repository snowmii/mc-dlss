#version 450

// Post-scene velocity merge for the VELOCITY_MRT route, in normalized device units.
//
// The scene's RG16_FLOAT velocity companion carries genuine object motion from the retained
// writers and the invalid sentinel everywhere else. This dispatch merges the complete field
// into the module-owned motion image - the sole Streamline motion source: a pixel that
// already carries object motion is copied unchanged, while a pixel whose payload is still
// the sentinel (terrain and sky the writers do not cover) is reprojected through the same
// jitter-stripped camera matrix the camera-only pass uses.
//
// The companion is a sampled input only and is never bound as storage: Minecraft creates it
// without storage usage, so this pass reads it exactly as the renderers wrote it.
//
// The reprojection and the depth handling match mc_dlss_motion.comp: the pixel centre maps
// straight onto NDC without a flip (Vulkan's framebuffer origin is top-left), the depth value
// travels through the reprojection as the z of a clip position and comes back out through the
// divide, and a zero w reports no motion rather than dividing by zero.
//
// On a reset frame no pixel may be reconstructed: the reprojection is the identity, which
// would read as "the camera stood still" instead of "there is no predecessor", and the
// destination holds the previous frame's merged field. The invalid sentinel is written
// everywhere; DLSS receives the reset flag separately and discards its history.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depthTexture;
layout(set = 0, binding = 1) uniform sampler2D velocityTexture;
layout(set = 0, binding = 2, rg16f) uniform writeonly image2D motionImage;
// The DLSS-G viewport consumes the backbuffer's orientation, which is the engine's mirrored
// about the horizontal axis: the FG motion copy receives every vector - object vectors copied
// from the companion included - at the mirrored pixel with its y component negated, so the
// plugin's motion reads agree with its mirrored inputs.
layout(set = 0, binding = 3, rg16f) uniform writeonly image2D flippedMotionImage;

layout(push_constant) uniform VelocityFillPushConstants {
	mat4 reprojection;
	ivec2 renderSize;
	int reset;
} constants;

const float INVALID_VELOCITY = 10000.0;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	// The dispatch is rounded up to whole workgroups, so the last one runs past the image.
	if (pixel.x >= constants.renderSize.x || pixel.y >= constants.renderSize.y) {
		return;
	}

	// A reset frame has no valid predecessor: the destination holds last frame's merged
	// field, so every pixel is forced to the invalid sentinel rather than reconstructed.
	if (constants.reset != 0) {
		imageStore(motionImage, pixel, vec4(INVALID_VELOCITY, INVALID_VELOCITY, 0.0, 0.0));
		imageStore(flippedMotionImage, ivec2(pixel.x, constants.renderSize.y - 1 - pixel.y),
			vec4(INVALID_VELOCITY, -INVALID_VELOCITY, 0.0, 0.0));
		return;
	}

	vec2 current = texelFetch(velocityTexture, pixel, 0).xy;
	// Only the invalid sentinel is reconstructed: a payload that already carries motion is
	// exactly what the scene writers wrote, and replacing it with camera motion would erase
	// the object's move. Both components must be sentinel - a real vector is never anywhere
	// near the sentinel magnitude, and every writer stores both components together.
	if (current.x != INVALID_VELOCITY || current.y != INVALID_VELOCITY) {
		imageStore(motionImage, pixel, vec4(current, 0.0, 0.0));
		imageStore(flippedMotionImage, ivec2(pixel.x, constants.renderSize.y - 1 - pixel.y),
			vec4(current.x, -current.y, 0.0, 0.0));
		return;
	}

	float depth = texelFetch(depthTexture, pixel, 0).x;
	vec2 ndc = ((vec2(pixel) + 0.5) / vec2(constants.renderSize)) * 2.0 - 1.0;
	vec4 previous = constants.reprojection * vec4(ndc, depth, 1.0);
	// A zero w is a point the previous camera cannot see at all; reporting no motion leaves
	// DLSS with this frame's own colour rather than a division by zero.
	vec2 motion = previous.w == 0.0 ? vec2(0.0) : previous.xy / previous.w - ndc;
	imageStore(motionImage, pixel, vec4(motion, 0.0, 0.0));
	imageStore(flippedMotionImage, ivec2(pixel.x, constants.renderSize.y - 1 - pixel.y),
		vec4(motion.x, -motion.y, 0.0, 0.0));
}
