#version 450
#extension GL_GOOGLE_include_directive : require

#include "highlight_compression.glsl"

// Converts DLSS-RR's linear HDR output into Minecraft's existing SDR RGBA8 scratch.
// ACES handles scene-referred values above one; the transfer function then produces the
// sRGB values Minecraft's RGBA8 target expects.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D hdrImage;
layout(set = 0, binding = 2) uniform sampler2D reflectionImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D sdrImage;

layout(push_constant) uniform ToneMapPushConstants {
	ivec2 outputSize;
	float exposure;
	int hasReflection;
} constants;

vec3 aces(vec3 color) {
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	color = max(color, vec3(0.0));
	return clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);
}

vec3 linearToSrgb(vec3 color) {
	vec3 encoded = 1.055 * pow(max(color, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
	return mix(encoded, color * 12.92, lessThanEqual(color, vec3(0.0031308)));
}

float dither(ivec2 pixel) {
	return fract(52.9829189 * fract(dot(vec2(pixel), vec2(0.06711056, 0.00583715)))) - 0.5;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= constants.outputSize.x || pixel.y >= constants.outputSize.y) {
		return;
	}

	float exposure = constants.exposure > 0.0 ? constants.exposure : 1.0;
    vec3 hdr = texelFetch(hdrImage, pixel, 0).rgb;
    if (constants.hasReflection != 0) {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(constants.outputSize);
        hdr += textureLod(reflectionImage, uv, 0.0).rgb;
    }
    vec3 radiance = compressHighlights(hdr, exposure);
	vec3 color = linearToSrgb(aces(radiance));
	// Dither only at final 8-bit quantization. Half an LSB hides shadow bands without lifting black.
	color = clamp(color + dither(pixel) / 255.0, 0.0, 1.0);
	imageStore(sdrImage, pixel, vec4(color, 1.0));
}
