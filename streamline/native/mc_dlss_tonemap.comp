#version 450
#extension GL_GOOGLE_include_directive : require

#include "highlight_compression.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D hdrImage;
layout(set = 0, binding = 2) uniform sampler2D reflectionImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D sdrImage;

layout(push_constant) uniform ToneMapPushConstants {
	ivec2 outputSize;
	float exposure;
	int hasReflection;
	int tonemapOperator;
} constants;

vec3 aces(vec3 color) {
	const float a = 2.51;
	const float b = 0.03;
	const float c = 2.43;
	const float d = 0.59;
	const float e = 0.14;
	color = max(color, vec3(0.0));
	return clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);
}

vec3 toneMapReinhardJodie(vec3 color) {
	color = max(color, vec3(0.0)) * 1.3;
	float lum = dot(color, vec3(0.2126, 0.7152, 0.0722));
	vec3 tc = color / (vec3(1.0) + color);
	return clamp(mix(color / (1.0 + lum), tc, tc), 0.0, 1.0);
}

vec3 toneMapReinhardModified(vec3 color) {
	color = max(color, vec3(0.0)) * 1.3;
	float lum = dot(color, vec3(0.2126, 0.7152, 0.0722));
	if (lum <= 1.0e-6) return vec3(0.0);
	const float whiteMaxLuminance = 3.5;
	float reinhard = (lum * (1.0 + lum / (whiteMaxLuminance * whiteMaxLuminance))) / (1.0 + lum);
	return clamp(color * (reinhard / lum), 0.0, 1.0);
}

vec3 applyUc2Curve(vec3 x) {
	const float A = 0.22;
	const float B = 0.30;
	const float C = 0.10;
	const float D = 0.20;
	const float E = 0.01;
	const float F = 0.30;
	return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - (E / F);
}

vec3 toneMapHableUc2(vec3 color) {
	color = max(color, vec3(0.0));
	const float exposureBias = 2.0;
	vec3 curr = applyUc2Curve(exposureBias * color);
	const float whiteScale = 5.1;
	vec3 white = vec3(1.0) / applyUc2Curve(vec3(whiteScale));
	return clamp(curr * white, 0.0, 1.0);
}

vec3 toneMapHejiHableAlu(vec3 color) {
	color = max(color, vec3(0.0));
	vec3 x = max(vec3(0.0), color * 1.5 - 0.004);
	vec3 srgbMapped = (x * (6.2 * x + 0.5)) / (x * (6.2 * x + 1.7) + 0.06);
	return clamp(pow(srgbMapped, vec3(2.2)), 0.0, 1.0);
}

vec3 toneMapKhronosPbrNeutral(vec3 color) {
	color = max(color, vec3(0.0));
	const float startCompression = 0.8 - 0.04;
	const float desaturation = 0.15;
	float x = min(color.r, min(color.g, color.b));
	float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
	color -= offset;
	float peak = max(color.r, max(color.g, color.b));
	if (peak < startCompression) return max(color, vec3(0.0));
	const float d = 1.0 - startCompression;
	float newPeak = 1.0 - d * d / (peak + d - startCompression);
	color *= newPeak / peak;
	float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
	return clamp(mix(color, vec3(newPeak), g), 0.0, 1.0);
}

const mat3 AGX_INPUT_MATRIX = mat3(
	0.842479062253094, 0.0423282422610123, 0.0423756549057051,
	0.0784335996993431, 0.8784686364945728, 0.0784336121205283,
	0.0792237451477642, 0.0791661274605434, 0.8791429734169974
);
const mat3 AGX_OUTPUT_MATRIX = mat3(
	1.1968790242583057, -0.05289685175753, -0.0529716355084725,
	-0.0980208811401368, 1.15190312990417, -0.0980434501171241,
	-0.0990297440797205, -0.09896117685894, 1.1510736726418468
);

vec3 agxDefaultContrastApprox(vec3 x) {
	vec3 x2 = x * x;
	vec3 x4 = x2 * x2;
	return + 15.5     * x4 * x2
	       - 40.14    * x4 * x
	       + 31.96    * x4
	       - 6.868    * x2 * x
	       + 0.4298   * x2
	       + 0.1191   * x
	       - 0.00232;
}

vec3 toneMapAgX(vec3 color) {
	color = max(color, vec3(0.0));
	vec3 val = color * (1.0 / 0.18);
	vec3 agx = AGX_INPUT_MATRIX * val;
	const float minEv = -10.0;
	const float maxEv = 6.5;
	agx = clamp(log2(max(agx, vec3(1.0e-5))), minEv, maxEv);
	agx = (agx - minEv) / (maxEv - minEv);
	agx = clamp(agxDefaultContrastApprox(agx), 0.0, 1.0);
	vec3 srgbDisplay = clamp(AGX_OUTPUT_MATRIX * agx, 0.0, 1.0);
	return pow(srgbDisplay, vec3(2.2));
}

vec3 toneMapLinear(vec3 color) {
	return clamp(color, 0.0, 1.0);
}

vec3 toneMap(vec3 color, int op) {
	switch (op) {
		case 1:
			return toneMapReinhardJodie(color);
		case 2:
			return toneMapReinhardModified(color);
		case 3:
			return toneMapHableUc2(color);
		case 4:
			return toneMapHejiHableAlu(color);
		case 5:
			return toneMapKhronosPbrNeutral(color);
		case 6:
			return toneMapAgX(color);
		case 7:
			return toneMapLinear(color);
		case 0:
		default:
			return aces(color);
	}
}

vec3 linearToSrgb(vec3 color) {
	vec3 encoded = 1.055 * pow(max(color, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
	return mix(encoded, color * 12.92, lessThanEqual(color, vec3(0.0031308)));
}

float dither(ivec2 pixel) {
	return fract(52.9829189 * fract(dot(vec2(pixel), vec2(0.06711056, 0.00583715)))) - 0.5;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= constants.outputSize.x || pixel.y >= constants.outputSize.y) {
		return;
	}

	float exposure = constants.exposure > 0.0 ? constants.exposure : 1.0;
	vec3 hdr = texelFetch(hdrImage, pixel, 0).rgb;
	if (constants.hasReflection != 0) {
		vec2 uv = (vec2(pixel) + 0.5) / vec2(constants.outputSize);
		hdr += textureLod(reflectionImage, uv, 0.0).rgb;
	}

	vec3 color;
	if (constants.tonemapOperator == 0) {
		vec3 radiance = compressHighlights(hdr, exposure);
		color = linearToSrgb(aces(radiance));
	} else {
		vec3 exposed = max(hdr, vec3(0.0)) * exposure;
		if (any(isnan(exposed)) || any(isinf(exposed))) exposed = vec3(0.0);
		color = linearToSrgb(toneMap(exposed, constants.tonemapOperator));
	}

	color = clamp(color + dither(pixel) / 255.0, 0.0, 1.0);
	imageStore(sdrImage, pixel, vec4(color, 1.0));
}
